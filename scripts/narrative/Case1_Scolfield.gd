static func get_prologue() -> Array:
	return PROLOGUE


static func get_epilogue() -> Array:
	return EPILOGUE


static func get_briefing() -> Array[DialogueLine]:
	var seq: Array[DialogueLine] = []
	seq.append(_line("Уэллер", "Ну наконец-то. Ещё немного, и я бы сам за тобой поехал во второй раз за ночь. Выглядишь… почти как человек. Прогресс, я считаю."))
	seq.append(_line("Анна", "Спасибо, Мартин, очень тронута."))
	seq.append(_line("Уэллер", "Кроуфорд, я нашёл тебя вчера в баре в таком виде, что бармен думал вызывать скорую, а не такси. Ты хоть помнишь, как оказалась дома?"))
	seq.append(_line("Анна", "Смутно. Помню душ. Помню, что кофе был отвратительный."))
	seq.append(_line("Уэллер", "Кофе был нормальный, это ты была отвратительная. Я тебя два часа приводил в чувство. Душ, кофе, ещё кофе, потом ты вышла покурить и вернулась чуть более похожей на живого человека. Знаешь, что было бы с любым другим следователем в отделе после третьего такого раза за месяц?"))
	seq.append(_line("Анна", "Дай угадаю. Собеседование с наставником, потом — с отделом кадров, а потом — прощальная вечеринка с тортом в форме значка."))
	seq.append(_line("Уэллер", "Их бы уже не было здесь, Анна. Совсем. А тебя держат, потому что ты… Неважно. Просто. Это не может продолжаться вечно. Я не собираюсь читать тебе нотации каждое утро до конца карьеры. Просто… однажды меня может не оказаться рядом, чтобы вытащить тебя из бара до того, как это увидит кто-то, кому будет всё равно, что ты — лучший следователь отдела."))

	var opts: Array[DialogueChoice] = []
	opts.append(_choice("Тогда постарайся оказываться рядом почаще, Уэллер. У тебя явно неплохо получается.", "PROBE", [
		_line("Анна", "Тогда постарайся оказываться рядом почаще, Уэллер. У тебя явно неплохо получается."),
	], {"set_coping_style": "SARCASM"}))
	opts.append(_choice("Я в порядке. Правда. Просто тяжёлая неделя.", "PROBE", [
		_line("Анна", "Я в порядке. Правда. Просто тяжёлая неделя."),
	], {"set_coping_style": "DENIAL", "trust": -5}))
	opts.append(_choice("Знаю. Прости. Правда, прости — и за вчера, и за то, что это явно не последний раз.", "PROBE", [
		_line("Анна", "Знаю. Прости. Правда, прости — и за вчера, и за то, что это явно не последний раз."),
	], {"set_coping_style": "VULNERABLE", "trust": 10}))
	seq.append(_decision(opts))

	seq.append(_line("Анна", "Кстати. От меня хоть не пахнет? Скажи честно, потому что если сейчас в допросную войдёт кто-то с собачьим нюхом…"))
	seq.append(_line("Уэллер", "Есть немного. Но, к счастью, большинство наших подозреваемых сами приходят такими, что перекроют что угодно. Мятная жвачка на столе, кстати, — я тебе оставил. Не благодари."))
	seq.append(_line("Анна", "Не буду. Ладно — рассказывай, что у нас."))
	seq.append(_line("Уэллер", "Эдвард Сколфилд. Бывший военный, сорок три. Двадцать лет службы, вышел на пенсию три года назад. Жена — Тамара, пасынок — Грег, пятнадцать. Отношения между ними были… скажем так, не отношения, а холодная война. Соседи слышали крики регулярно. Тамара в полицию не звонила ни разу — типичная картина. Алиби — дырявое. Камера у гаража поймала его отъезд через несколько минут после предполагаемого времени смерти. Судя по всему, он думал, что временная разница спишется на погрешность экспертизы. Не спишется."))
	return seq


static func _line(speaker: String, text: String, internal: bool = false, emotion: String = "", required: String = "") -> DialogueLine:
	var line := DialogueLine.new()
	line.speaker = speaker
	line.text = text
	line.internal_thought = internal
	line.portrait_emotion = emotion
	line.required_url = required
	return line


static func _choice(label: String, kind: String, response: Array, opts: Dictionary = {}) -> DialogueChoice:
	var choice := DialogueChoice.new()
	choice.label = label
	choice.kind = kind
	choice.response = response
	choice.tactic_id = opts.get("tactic_id", "")
	choice.requires_clue = opts.get("requires_clue", "")
	choice.set_coping_style = opts.get("set_coping_style", "")
	choice.weller_trust_delta = opts.get("trust", 0)
	choice.unlock_trait = opts.get("unlock_trait", "")
	return choice


static func _decision(choices: Array[DialogueChoice]) -> DialogueLine:
	var line := DialogueLine.new()
	line.choices = choices
	return line
