static func build() -> CaseData:
	var case := CaseData.new()
	case.case_id = CASE_ID
	case.suspect_name = SUSPECT
	var initial: Array[String] = []
	initial.assign(INITIAL_TACTICS)
	case.initial_tactics = initial
	case.url_registry = _url_registry()
	var phases: Array[InterrogationPhase] = []
	phases.append(_phase_baseline())
	phases.append(_phase_evidence())
	phases.append(_phase_manslaughter())
	phases.append(_phase_premeditation())
	case.phases = phases
	return case


static func get_prologue() -> Array:
	return PROLOGUE


static func get_epilogue() -> Array:
	return EPILOGUE


static func get_briefing() -> Array[DialogueLine]:
	var seq: Array[DialogueLine] = []
	seq.append(_line("Уэллер", "Ну наконец-то. Ещё немного, и я бы сам за тобой поехал во второй раз за ночь. Выглядишь… почти как человек. Прогресс, я считаю."))
	seq.append(_line("Анна", "Спасибо, Мартин, очень тронута."))
	seq.append(_line("Уэллер", "Кроуфорд, я нашёл тебя вчера в баре в таком виде, что бармен думал вызывать скорую, а не такси. Ты хоть помнишь, как оказалась дома?"))
	seq.append(_line("Анна", "Смутно. Помню душ. Помню, что кофе был отвратительный."))
	seq.append(_line("Уэллер", "Кофе был нормальный, это ты была отвратительная. Я тебя два часа приводил в чувство. Душ, кофе, ещё кофе, потом ты вышла покурить и вернулась чуть более похожей на живого человека. Знаешь, что было бы с любым другим следователем в отделе после третьего такого раза за месяц?"))
	seq.append(_line("Анна", "Дай угадаю. Собеседование с наставником, потом — с отделом кадров, а потом — прощальная вечеринка с тортом в форме значка."))
	seq.append(_line("Уэллер", "Их бы уже не было здесь, Анна. Совсем. А тебя держат, потому что ты… Неважно. Просто. Это не может продолжаться вечно. Я не собираюсь читать тебе нотации каждое утро до конца карьеры. Просто… однажды меня может не оказаться рядом, чтобы вытащить тебя из бара до того, как это увидит кто-то, кому будет всё равно, что ты — лучший следователь отдела."))

	var opts: Array[DialogueChoice] = []
	opts.append(_choice("Тогда постарайся оказываться рядом почаще, Уэллер. У тебя явно неплохо получается.", "PROBE", [
		_line("Анна", "Тогда постарайся оказываться рядом почаще, Уэллер. У тебя явно неплохо получается."),
	], {"set_coping_style": "SARCASM"}))
	opts.append(_choice("Я в порядке. Правда. Просто тяжёлая неделя.", "PROBE", [
		_line("Анна", "Я в порядке. Правда. Просто тяжёлая неделя."),
	], {"set_coping_style": "DENIAL", "trust": -5}))
	opts.append(_choice("Знаю. Прости. Правда, прости — и за вчера, и за то, что это явно не последний раз.", "PROBE", [
		_line("Анна", "Знаю. Прости. Правда, прости — и за вчера, и за то, что это явно не последний раз."),
	], {"set_coping_style": "VULNERABLE", "trust": 10}))
	seq.append(_decision(opts))

	seq.append(_line("Анна", "Кстати. От меня хоть не пахнет? Скажи честно, потому что если сейчас в допросную войдёт кто-то с собачьим нюхом…"))
	seq.append(_line("Уэллер", "Есть немного. Но, к счастью, большинство наших подозреваемых сами приходят такими, что перекроют что угодно. Мятная жвачка на столе, кстати, — я тебе оставил. Не благодари."))
	seq.append(_line("Анна", "Не буду. Ладно — рассказывай, что у нас."))
	seq.append(_line("Уэллер", "Эдвард Сколфилд. Бывший военный, сорок три. Двадцать лет службы, вышел на пенсию три года назад. Жена — Тамара, пасынок — Грег, пятнадцать. Отношения между ними были… скажем так, не отношения, а холодная война. Соседи слышали крики регулярно. Тамара в полицию не звонила ни разу — типичная картина. Алиби — дырявое. Камера у гаража поймала его отъезд через несколько минут после предполагаемого времени смерти. Судя по всему, он думал, что временная разница спишется на погрешность экспертизы. Не спишется."))
	return seq


static func _phase_baseline() -> InterrogationPhase:
	var phase := InterrogationPhase.new()
	phase.phase_index = 0
	phase.milestone_name = "Baseline Calibration"
	phase.target_confession_url_id = ""
	var seq: Array[DialogueLine] = []
	seq.append(_line("Сколфилд", "Наконец-то. Слушайте, я тут уже два часа торчу. Может, кофе? Или у вас тут так заведено — мариновать людей, пока не сломаются?"))

	var probes: Array[DialogueChoice] = []
	probes.append(_choice("Спросить о службе в армии", "PROBE", [
		_line("Анна", "Двадцать лет в форме. Впечатляет. Где служили?"),
		_line("Сколфилд", "О, вот это разговор! [url=clue_army]Два тура в горячих точках[/url], слушайте, я вам расскажу — там таких, как ваши подозреваемые, только людьми не называли…", false, "proud"),
		_line("Анна", "Видишь его? Ему нравится это. Ему нравится, что на него смотрят. Такие, как он, не боятся допроса — они боятся, что их не оценят по достоинству.", true),
	]))
	probes.append(_choice("Спросить, как он себя чувствует", "PROBE", [
		_line("Анна", "Тяжёлый, наверное, был вчерашний день. Как вы вообще…"),
		_line("Сколфилд", "Тамара сама не своя. Я держусь ради неё. Кто-то же должен быть сильным."),
	]))
	seq.append(_decision(probes))
	phase.dialogue_sequence = seq
	return phase


static func _phase_evidence() -> InterrogationPhase:
	var phase := InterrogationPhase.new()
	phase.phase_index = 1
	phase.milestone_name = "Evidence Tampering"
	phase.target_confession_url_id = "confession_tampering"
	var seq: Array[DialogueLine] = []
	seq.append(_line("Анна", "Расскажите мне о бассейне. Просто опишите его — как он выглядит вечером, когда вы приходите с работы."))
	seq.append(_line("Сколфилд", "Хороший бассейн. [url=junk_concrete]Я сам заливал бетон под него[/url], между прочим. Тамара хотела нанять бригаду, а я сказал — зачем платить, я в армии и не такое строил. Подсветка снизу, ночью красиво светится, [url=clue_schedule]Грег там вечно торчал допоздна[/url], музыку свою слушал, я ему говорил — выключай свет, электричество не бесплатное."))
	seq.append(_line("Анна", "Значит, вы знали, что вечером он почти наверняка будет у бассейна."))
	seq.append(_line("Сколфилд", "Ну… да, обычно да. А что?"))
	seq.append(_line("Анна", "Ничего. Продолжайте — вы сказали, залили бетон сами. Расскажите про камеру у гаража, кстати — она направлена прямо на подъездную дорожку?"))
	seq.append(_line("Сколфилд", "Да, я сам её ставил. Хорошая штука, недорогая, но картинку даёт чёткую. Записывает всё, что происходит у гаража и краем — часть двора."))
	seq.append(_line("Анна", "То есть вы знали точно, что ваш отъезд будет зафиксирован с точностью до минуты."))
	seq.append(_line("Сколфилд", "К чему вы клоните?"))

	var tactics: Array[DialogueChoice] = []
	tactics.append(_choice("Злодей или ошибка", "TACTIC", [
		_line("Анна", "Знаете, Эдвард, я сижу в этой комнате не первый год. И знаете, что я поняла? Иногда сюда приводят настоящих чудовищ — тех, кто планирует, наслаждается, не испытывает ни капли раскаяния. А иногда сюда приводят людей, которые в какой-то момент просто… запаниковали. Сделали то, что в нормальном состоянии никогда бы не сделали, а потом наделали ошибок, пытаясь всё исправить. Это очень разные люди, Эдвард. И я пока не понимаю, к какой категории отнести вас. Помогите мне понять."),
		_line("Сколфилд", "Я… я его туда не клал, если вы об этом. То есть — не то чтобы клал. [url=confession_tampering]Я его переместил. Он уже был мёртв, ясно? Он уже не дышал, когда я до него дотронулся. Я запаниковал и затащил его в воду, чтобы было похоже, что он сам упал и захлебнулся. Это глупо, я знаю. Это было глупо.[/url]", false, "broken", "confession_tampering"),
	], {"tactic_id": "good_guy_monster"}))
	seq.append(_decision(tactics))
	seq.append(_line("Анна", "Вот он, первый кирпичик. Он думает, что это самое страшное, что он мне только что сказал. Он понятия не имеет, что я только начала.", true))
	phase.dialogue_sequence = seq
	return phase


static func _phase_manslaughter() -> InterrogationPhase:
	var phase := InterrogationPhase.new()
	phase.phase_index = 2
	phase.milestone_name = "Manslaughter"
	phase.target_confession_url_id = "confession_manslaughter"
	var seq: Array[DialogueLine] = []
	seq.append(_line("Анна", "Хорошо. Спасибо, что сказали правду про бассейн — это важно, Эдвард, правда важно. Теперь мне нужно, чтобы вы так же честно рассказали, что произошло до того, как вы к нему прикоснулись. Вы говорите, он уже не дышал. Что случилось перед этим?"))
	seq.append(_line("Сколфилд", "[url=clue_slip]Несчастный случай. Он поскользнулся, ударился головой о бортик, я нашёл его уже такого.[/url]"))

	var t1: Array[DialogueChoice] = []
	t1.append(_choice("Предъявить экспертизу", "TACTIC", [
		_line("Анна", "Эдвард, я должна быть с вами честна, раз уж вы честны со мной. Судмедэксперт не нашёл следов удара о бортик. Ни синяка, ни рассечения, ничего, что совпадало бы с падением. Зато есть кое-что другое. Странгуляционные борозды на шее. Понимаете, что это значит?"),
		_line("Сколфилд", "Это не то, что вы думаете."),
		_line("Анна", "Тогда расскажите мне, что это. Потому что пока что выглядит так, будто вы душили пятнадцатилетнего мальчика, Эдвард. И я не знаю больше ни одной версии событий, которая объясняет эти борозды на шее. Может, вы знаете?"),
	], {"tactic_id": "present_forensics"}))
	seq.append(_decision(t1))

	var t2: Array[DialogueChoice] = []
	t2.append(_choice("Апелляция к чести", "TACTIC", [
		_line("Анна", "Вы ведь уже сделали трудную часть, Эдвард. Вы сказали мне правду про бассейн, хотя могли соврать. Это говорило о том, что вы за человек. Не останавливайтесь на середине пути — это будет выглядеть хуже, чем если бы вы вообще ничего не сказали."),
		_line("Сколфилд", "Он меня достал, ясно? Постоянно, каждый день, это маленькое неблагодарное дерьмо — простите — доставал меня. В тот день он снова начал, я подошёл, чтобы… не знаю, встряхнуть его, что ли, привести в чувство. [url=confession_manslaughter]Схватил его за горло — не чтобы убить, просто чтобы заткнуть, чтобы он замолчал хоть на секунду. А он начал вырываться, а я… я не рассчитал. Держал слишком долго. Он обмяк, и я понял — слишком поздно. Это не было убийством. Это был несчастный случай, который начался с того, что я хотел его просто напугать.[/url]", false, "breaking", "confession_manslaughter"),
	], {"tactic_id": "appeal_to_honor"}))
	seq.append(_decision(t2))
	seq.append(_line("Анна", "Второй кирпичик. Осталось самое сложное — доказать, что он не просто «не рассчитал». Что он хотел этого задолго до бассейна.", true))
	phase.dialogue_sequence = seq
	return phase


static func _phase_premeditation() -> InterrogationPhase:
	var phase := InterrogationPhase.new()
	phase.phase_index = 3
	phase.milestone_name = "Premeditation"
	phase.target_confession_url_id = "confession_premeditation"
	var seq: Array[DialogueLine] = []
	seq.append(_line("Анна", "Эдвард, вы сказали — «хотел его напугать». Скажите, вы ведь не в первый раз были в гневе из-за Грега?"))
	seq.append(_line("Сколфилд", "Он трудный был парень. Я поднимал на него руку, да, признаю, не горжусь этим. Но это разные вещи — подзатыльник и то, что вы мне сейчас пытаетесь пришить."))
	seq.append(_line("Анна", "Тамара рассказала нам, что за неделю до случившегося вы сказали ей нечто вроде — цитирую — «однажды я не сдержусь, и тогда пусть пеняет на себя». Это ваши слова?"))
	seq.append(_line("Сколфилд", "Люди говорят разное сгоряча. [url=clue_defense_trap]Это не значит, что я планировал что-то сделать.[/url] Я говорил это, да. И что? Каждый родитель в бешенстве говорит то, чего не думает."))
	seq.append(_line("Анна", "Эдвард, я не спрашивала, планировали ли вы. Вы сами это сказали. Почему?"))
	seq.append(_line("Сколфилд", "…Потому что вы всё равно попытаетесь это доказать. Вам всем нужен монстр, а не человек, который сорвался. Проще посадить монстра."))

	var tactics: Array[DialogueChoice] = []
	tactics.append(_choice("Прямая конфронтация", "TACTIC", [
		_line("Анна", "Мне не нужен монстр, Эдвард. Мне нужна правда. Вы сказали жене, что однажды не сдержитесь. За неделю до смерти Грега. Это звучит не как вспышка гнева в моменте. Это звучит как человек, который уже тогда знал, что произойдёт что-то серьёзное, и предупреждал об этом заранее. Так что случилось в тот день у бассейна? Вы правда просто «хотели напугать», или в глубине души вы уже знали, что на этот раз не остановитесь?"),
		_line("Сколфилд", "[url=confession_premeditation]Я подумал об этом заранее. В то утро. Когда он опять мне нахамил за завтраком — я подумал: «сегодня, если он опять начнёт, я его заткну навсегда». Я не гнал эту мысль, Тамара уехала к сестре, дом был пустой, я знал, что если это случится сегодня — никто не помешает. А потом он начал у бассейна, и я… не сорвался. Я просто сделал то, о чём думал всё утро.[/url]", false, "defeated", "confession_premeditation"),
	], {"tactic_id": "direct_confrontation"}))
	seq.append(_decision(tactics))
	phase.dialogue_sequence = seq
	return phase


static func _url_registry() -> Dictionary:
	return {
		"clue_army": {"type": "trait", "value": "NARCISSISM", "log": "Черта разблокирована: Нарциссизм. Он расцветает, когда им восхищаются."},
		"junk_concrete": {"type": "flavor", "log": "Он сам заливал бетон. Мелочь, которой он гордится."},
