; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="first_degree_v2"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
SuspectProfileManager="*res://scripts/autoload/SuspectProfileManager.gd"
NotebookManager="*res://scripts/autoload/NotebookManager.gd"
DiscoveryEventManager="*res://scripts/autoload/DiscoveryEventManager.gd"
LocalizationManager="*res://scripts/autoload/LocalizationManager.gd"
GameSettings="*res://scripts/autoload/GameSettings.gd"
CharacterDatabase="*res://scripts/autoload/CharacterDatabase.gd"
ObjectiveManager="*res://scripts/autoload/ObjectiveManager.gd"
DialogueStateManager="*res://scripts/autoload/DialogueStateManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
ThemeManager="*res://scripts/autoload/ThemeManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
MenuController="*res://scripts/autoload/MenuController.gd"
NotificationUI="*res://scripts/autoload/NotificationUI.gd"
__InkRuntime="*res://addons/inkgd/ink_runtime.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/inkgd/plugin.cfg", "res://addons/ink_csv_sync/plugin.cfg")

[inkgd]

register_templates=false

[layer_names]

3d_physics/layer_4="interactables"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
