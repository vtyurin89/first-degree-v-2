[resource]
script = ExtResource("1")
document_id = "case_4417_c"
title = "МАТЕРИАЛЫ ДЕЛА № 4417-C"
subtitle = "Полицейское управление Редфорда · Отдел убийств"
cover_title = "ДЕЛО № 4417-C // КЕДРОВАЯ АЛЛЕЯ, 214"
is_confidential = true
unlocked_in_office_only = false
pages = [{
"title": "МАТЕРИАЛЫ ДЕЛА № 4417-C",
"subtitle": "Полицейское управление Редфорда · Отдел убийств",
"photo_column": true,
"body": "[b]Объект:[/b] Смерть несовершеннолетнего\nАдрес происшествия: Кедровая аллея, 214\nПередано: Специальный отдел допросов (дет. А. Кроуфорд, дет. М. Уэллер)\nПередал дело: дет. Х. Дональдсон\n\n[b]1. Краткая сводка[/b]\nВ субботу в 17:44 Тамара Сколфилд (39 лет) вызвала службу 911: она обнаружила своего сына, Грегори «Грега» Нолана (15 лет), в бассейне во дворе их дома. Прибывший наряд констатировал смерть. Первичный осмотр и вскрытие показали, что мальчик был задушен, а в воду его поместили уже мёртвым.\n\n[color=#8a6d2e][b]Оперативные данные:[/b][/color]\n• Вероятное время смерти: 15:30 – 15:50.\n• Отчим (Эдвард Сколфилд, 43): по камере магазина «Фудмарт» впервые замечен в 16:09.\n• Показания отчима: утверждает, что уехал в магазин «около 15:15» и вернулся после звонка жены.\n\n[b]Осмотр места происшествия[/b]\nДвор огорожен глухим забором, калитка заперта изнутри, следов незаконного проникновения нет. На плитке у бассейна обнаружены характерные полосы волочения тела."
}, {
"title": "ПОТЕРПЕВШИЙ",
"subtitle": "Личное дело несовершеннолетнего",
"body": "[b]Грегори «Грег» Нолан[/b]\n\n[b]Возраст:[/b] 15 лет\n[b]Класс:[/b] 10-й ученик\n[b]Родственные связи:[/b] Сын Тамары Сколфилд от первого брака. Родной отец проживает в другом штате (официально уведомлён).\n\n[color=#6b5a43][b]Характеристика и привычки[/b][/color]\nВечерами обычно проводил время у дворового бассейна. Конфликтов со сверстниками за последнее время не зафиксировано. Школьные показатели стабильные.",
"photo_path": "res://assets/photos/victim_nolan.png",
"photo_label": "victim_nolan.png"
}, {
"title": "ПОДОЗРЕВАЕМЫЙ",
"subtitle": "Анкетные данные и оперативные примечания",
"body": "[b]Эдвард Джеймс Сколфилд[/b]\n\n[b]Возраст:[/b] 43 года\n[b]Статус:[/b] Отчим погибшего (в браке 3 года)\n[b]Профессиональный статус:[/b] Ветеран, 20 лет службы, уволен в запас 3 года назад. Судимостей не имеет.\n\n[color=#8a6d2e][b]Оперативные примечания:[/b][/color]\n• Склонен к вспышкам гнева. Мать подтвердила рукоприкладство в отношении Грега.\n• Владеет легальным Sig Sauer P320 (9 мм). Сейф в спальне не вскрывался.\n• На левом предплечье обнаружены три свежие царапины (объясняет контактом с розовым кустом).",
"photo_path": "res://assets/photos/suspect_scofield.png",
"photo_label": "suspect_scofield.png",
"margin_note": "«Камеру Сколфилд упомянул сам. Либо ему нечего скрывать, либо он не знает, что она пишет с точностью до минуты».",
"margin_author": "— дет. Уэллер"
}, {
"title": "ЭКСПЕРТИЗА И РАСХОЖДЕНИЯ",
"subtitle": "Предварительный медкомиссионный отчёт",
"body": "[b]Причина смерти[/b]\nМеханическая асфиксия, сдавление шеи. Обнаружены следы пальцев рук на шее, кровоизлияния в мягких тканях и точечные кровоизлияния на лице.\n\n[color=#8a6d2e][b]Ключевые выводы патологоанатома:[/b][/color]\n• Признаков утопления нет: пенистых выделений в дыхательных путях нет, лёгкие не раздуты, воды в желудке не обнаружено. Тело помещено в воду уже после смерти.\n• Травм о бортик бассейна или иные твёрдые предметы не зафиксировано.\n• Под ногтями потерпевшего изъят биологический материал (ДНК отправлена в обработку).\n\n[b]Выявленные расхождения в показаниях:[/b]\n• Эдвард называет время выезда «около 15:15». Камера у гаража фиксирует иное время.\n• В магазине «Фудмарт» обвиняемый отсутствует в период вероятной смерти подростка.\n• Версия «несчастный случай» полностью опровергнута судмедэкспертизой."
}, {
"title": "ПРИЛОЖЕНИЯ И МАТЕРИАЛЫ",
"subtitle": "Реестр собранных доказательств и справок",
"body": "Перечень приобщённых к делу вещдоков и документов (от A до J):\n\n[b][A][/b] Хронология событий\n[b][B][/b] Показания свидетелей (Т. Сколфилд, соседка, друг)\n[b][C][/b] Выписка из личного дела Э. Сколфилда\n[b][D][/b] Кадр с камеры у гаража\n[b][E][/b] Кадр с камеры магазина «Фудмарт»\n[b][F][/b] Протокол вскрытия (полный)\n[b][G][/b] Фото осмотра места преступления\n[b][H][/b] Переписка с телефона Грега\n[b][I][/b] Фото царапин на предплечье Эдварда\n[b][J][/b] Записи школьного психолога\n\nПроцессуальный статус подозреваемого: Свидетель (не задержан).\n[color=#8b0000][b]ТРЕБУЕТСЯ ДОПРОС[/b][/color]"
}]
