[resource]
script = ExtResource("1_wd")
id = "book_interrogation"
title = "Допрос: практическое руководство"
body = "«Молчание — не признание. Молчание — стратегия.\n\nВаша задача не заставить подозреваемого говорить, а сделать молчание невыгодным. Каждая деталь, которую он отрицает, — это ещё одна точка, где его можно поймать.\n\nНикогда не спрашивайте «почему». Спрашивайте «как».»"
kind = "book"
author = ""
date = ""
