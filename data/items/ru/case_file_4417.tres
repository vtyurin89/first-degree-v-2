script = ExtResource("1_wd")
id = "case_file_4417"
title = "Дело №4417-С"
body = "Жертва: Грегори Мэйсон, 15 лет. Пасынок подозреваемого.\n\nПричина смерти: асфиксия. Странгуляционные борозды на шее. Токсикология чистая.\n\nАлиби подозреваемого частично опровергнуто записью с камеры у гаража.\n\nПримечание Анны: он следит за тем, как я реагирую. Не торопиться. Держать лицо."
kind = "case_file"
author = ""
date = ""
