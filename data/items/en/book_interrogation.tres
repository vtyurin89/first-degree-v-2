script = ExtResource("1_wd")
id = "book_interrogation"
title = "Interrogation: A Field Manual"
body = "'Silence is not a confession. Silence is a strategy.\n\nYour job is not to make the suspect talk, but to make silence unprofitable. Every detail he denies is one more place to catch him.\n\nNever ask 'why'. Ask 'how'.'"
